{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derecherche.dev/schema/engines.schema.json",
  "title": "Derecherche engine catalog file",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "engines"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "engines": {
      "type": "array",
      "items": { "$ref": "#/$defs/engine" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "engine": {
      "type": "object",
      "required": ["id", "providerId", "name", "category", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "providerId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/id" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "url": {
          "type": "string",
          "pattern": "^https?://.*\\{q\\}.*$"
        },
        "icon": { "$ref": "#/$defs/id" },
        "triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "regions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "order": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "broken"],
          "default": "active"
        },
        "replacedBy": { "$ref": "#/$defs/id" },
        "legacyId": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
