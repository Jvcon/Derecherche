{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derecherche.dev/schema/categories.schema.json",
  "title": "Derecherche category catalog",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "categories"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "category": {
      "type": "object",
      "required": ["id", "name", "order"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "number" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "icon": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/subcategory" }
        }
      }
    },
    "subcategory": {
      "type": "object",
      "required": ["id", "name", "order"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "number" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "icon": { "$ref": "#/$defs/id" },
        "description": { "type": "string" }
      }
    }
  }
}
