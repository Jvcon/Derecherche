{
  "name": "@derecherche/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Shadow DOM UI primitives for Derecherche",
  "license": "GPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
